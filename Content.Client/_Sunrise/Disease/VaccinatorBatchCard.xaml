<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Class="Content.Client._Sunrise.Disease.VaccinatorBatchCard"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         SetWidth="240"
         MinHeight="150"
         Margin="4">
    <PanelContainer Name="MainPanel"
                    VerticalExpand="True">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      SeparationOverride="8"
                      Margin="8">
            <controls:StripeBack HorizontalExpand="True">
                <Label Name="CodeLabel"
                       StyleClasses="LabelHeading"
                       HorizontalAlignment="Center"
                       HorizontalExpand="True"/>
            </controls:StripeBack>

            <BoxContainer Name="ClaimsContainer"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SeparationOverride="2"/>

            <Button Name="SynthesizeButton"
                    HorizontalExpand="True"
                    MinHeight="30"/>
        </BoxContainer>
    </PanelContainer>
</Control>
