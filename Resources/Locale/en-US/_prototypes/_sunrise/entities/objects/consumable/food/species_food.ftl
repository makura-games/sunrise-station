    .desc = Fried milira meat.
ent-FoodMeatNianCooked = nian steak
    .desc = Fried nian meat.
ent-FoodMeatResomiCooked = resomi steak
    .desc = Fried resomi meat.
ent-FoodMeatSwineCooked = trotin steak
    .desc = Fried trotin meat.
ent-FoodMeatTajaranCooked = tajaran steak
    .desc = Fried tajaran meat.
