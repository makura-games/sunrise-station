### Field tools of a virologist.

disease-scanner-examine = Paper left: { $paper } of { $max }.
disease-scanner-popup-full = The paper tray is already full.
disease-scanner-popup-reloaded = Paper loaded. Sheets now: { $paper }.
disease-scanner-popup-empty = The analyzer is out of paper.

disease-disinfectant-popup-cleaned = The disinfectant kills the contagion.
disease-disinfectant-popup-body = The disinfectant burns the contagion off the body.

disease-overlay-source-line = { $name } [{ $strain }]
disease-overlay-carrier-line = { $name } [{ $strain }] stage { $stage }/{ $count }

disease-sterilizer-examine = The tank holds { $units } u of disinfectant, each pass uses { $cost } u.
disease-sterilizer-popup-sprayed = A cloud of disinfectant washes over you.
disease-sterilizer-popup-cleaned = Your belongings stop smelling of contagion.
disease-sterilizer-popup-alarm = The sterilizer arch beeps in alarm!

disease-slot-vaccine = Vaccine
disease-vaccine-injector-examine-loaded = Loaded with a vaccine against strain [color=yellow]{ $strain }[/color].
disease-vaccine-injector-examine-empty = No vaccine is loaded.
disease-vaccine-injector-popup-empty = The injector has no vaccine loaded.
